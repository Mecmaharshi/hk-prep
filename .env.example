# Copy this file to .env (never pushed) and fill in what the contest gives you.
# Change LLM_PROVIDER to switch. Everything else is optional.

LLM_PROVIDER=fake          # fake | claude | openai
LLM_MODEL=                 # empty = the default for the provider (see backend/app/llm/)

# Claude
ANTHROPIC_API_KEY=

# OpenAI, or any OpenAI-compatible service (Groq, OpenRouter, Ollama, Gemini's compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=           # empty = api.openai.com
